{
  "name": "telemed-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Patient, doctor and admin surfaces of the telemed platform. One Next.js application, built once per surface.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/select-surface.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/select-surface.mjs",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint .",
    "gen:api": "npx -y openapi-typescript@7.13.0 ${OPENAPI_SPEC:-../telemed-api/openapi/v1.json} -o lib/api/schema.d.ts",
    "pretypecheck": "node scripts/select-surface.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:patient && npm run test:doctor && npm run test:admin",
    "build:patient": "TELEMED_SURFACE=patient NEXT_PUBLIC_TELEMED_SURFACE=patient npm run build",
    "build:doctor": "TELEMED_SURFACE=doctor NEXT_PUBLIC_TELEMED_SURFACE=doctor npm run build",
    "build:admin": "TELEMED_SURFACE=admin NEXT_PUBLIC_TELEMED_SURFACE=admin npm run build",
    "test:patient": "TELEMED_SURFACE=patient NEXT_PUBLIC_TELEMED_SURFACE=patient node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register.ts --test \"test/consumer/patient/*.test.ts\"",
    "test:doctor": "TELEMED_SURFACE=doctor NEXT_PUBLIC_TELEMED_SURFACE=doctor node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register.ts --test \"test/consumer/doctor/*.test.ts\"",
    "test:admin": "TELEMED_SURFACE=admin NEXT_PUBLIC_TELEMED_SURFACE=admin node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register.ts --test \"test/admin/*.test.ts\"",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "build:cf:patient": "TELEMED_SURFACE=patient NEXT_PUBLIC_TELEMED_SURFACE=patient npm run build",
    "build:cf:doctor": "TELEMED_SURFACE=doctor NEXT_PUBLIC_TELEMED_SURFACE=doctor npm run build",
    "build:cf:admin": "TELEMED_SURFACE=admin NEXT_PUBLIC_TELEMED_SURFACE=admin npm run build",
    "deploy:patient": "npm run build:cf:patient && wrangler deploy --env patient",
    "deploy:doctor": "npm run build:cf:doctor && wrangler deploy --env doctor",
    "deploy:admin": "npm run build:cf:admin && wrangler deploy --env admin"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "motion": "13.4.2",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "^19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.28.4",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.4",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-is": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "wrangler": "^4.131.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260910.1": true
  }
}
