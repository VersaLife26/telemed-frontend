# Cloudflare Workers Builds runs `npm clean-install` with parallel postinstalls.
# wrangler's nested esbuild then hits ETXTBSY (exec while the binary is still
# being written), often after a truncated @esbuild/linux-x64 tarball. Serialize
# lifecycle scripts so install.js only runs after the binary is on disk.
foreground-scripts=true
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
