# Which surface this build serves: patient | doctor | admin
TELEMED_SURFACE=patient

# Base URL of the telemed backend (the gateway).
#
# NEXT_PUBLIC_ matters for the test console specifically: the signalling
# websocket is opened by the browser directly against this URL, because a Next
# route handler cannot proxy a websocket upgrade. "localhost" therefore works
# from the same machine and fails from a phone on the LAN -- set the machine's
# LAN address to test a call across two devices.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- developer test console (/test) ---
# Defaults to true. This flag only decides whether the page renders; what
# actually keeps the endpoints behind it from existing is the backend's own
# TELEMED_TEST_MODE, which a production ENV overrides regardless.
NEXT_PUBLIC_TELEMED_TEST_MODE=true

GOOGLE_CLIENT_ID=
