# Which surface this build serves: patient | doctor | admin
TELEMED_SURFACE=patient

# Base URL of the telemed backend (the gateway).
#
# NEXT_PUBLIC_ matters for video calls: the browser connects to the API's
# SignalR hub (/hubs/consultation) directly against this URL, because a Next
# route handler cannot proxy a websocket. The API must list this site's origin
# in Cors:Origins. "localhost" works from the same machine and fails from a
# phone on the LAN -- set the machine's LAN address to test a call across two
# devices.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- developer test console (/test) ---
# Defaults to true. This flag only decides whether the page renders; the API's
# own Testing switches decide whether the endpoints behind it exist.
NEXT_PUBLIC_TELEMED_TEST_MODE=true
# Server-only. The proxy sends it as X-Test-Secret on /api/proxy/test/* calls.
# Must match the API's Testing:SharedSecret. Leave empty in production: anyone
# who can reach this site could otherwise read captured OTP codes.
TEST_SECRET=

GOOGLE_CLIENT_ID=
